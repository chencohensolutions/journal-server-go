# Binaries
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# IDEs
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
bin/
dist/

# Environment files
.env
.env.local

# Local certificates
/certs/*
!/certs/*.go

# Server state (admin API token, enrolled device registry)
admin.token
devices.json

# Portable libvips for Windows, made by scripts/bundle-vips
/vips/

# ONNX Runtime and the text search model, downloaded by scripts/bundle-onnx
/onnxruntime/
/models/

# Built by the "server: run" and "server: index now" tasks
/journal-server
/journal-indexer

# Output of "go run . > server.log"
/server.log
peers.json

# Installers kept in git LFS (releases/)
!releases/**/*.exe
