{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug GraphQL Server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "output": "${workspaceFolder}/debug.exe",
      "cwd": "${workspaceFolder}",
      "env": {
        "GO111MODULE": "on"
      },
      "args": []
    },
    {
      // Attaches to the server running under Delve on the server PC (192.168.50.2): start the
      // "server: debug (Delve on 0.0.0.0:2345)" task there first. Delve has no password; that task's comment says how to
      // let only the Mac reach port 2345. Both machines must be on the same commit, or breakpoints land on the wrong lines.
      "name": "Attach to server PC",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "192.168.50.2",
      "port": 2345,
      "substitutePath": [
        { "from": "${workspaceFolder}", "to": "${input:serverPcRepo}" }
      ]
    }
  ],
  "inputs": [
    {
      "id": "serverPcRepo",
      "type": "promptString",
      "description": "Where journal-server-go is on the server PC (forward slashes)",
      "default": "C:/src/journal/journal-server-go"
    }
  ]
}
