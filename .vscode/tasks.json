{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "phoneIp",
			"type": "promptString",
			"description": "Phone IP on the hotspot (from the 'adb: hotspot IP' task)"
		},
		{
			"id": "enrollUser",
			"type": "promptString",
			"description": "User to make an enrollment code for (as in config.json)",
			"default": "hen"
		}
	],
	"tasks": [
		{
			// Builds and starts the server with config.json from this folder; stop it with the trash icon or Ctrl+C.
			"label": "server: run",
			"type": "shell",
			"command": "go build -o journal-server . && ./journal-server",
			"windows": {
				"command": "go build -o journal-server.exe . ; if ($?) { .\\journal-server.exe }"
			},
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": {
				"owner": "go",
				"pattern": { "regexp": "^(.*\\.go):(\\d+):(\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "message": 4 },
				"background": { "beginsPattern": "^", "endsPattern": "Listening on https://" }
			},
			"presentation": { "panel": "dedicated", "reveal": "always", "clear": true }
		},
		{
			// Runs the server under Delve, waiting for "Attach to server PC" (launch.json) from another machine on port 2345.
			// Stop "server: run" first: both use port 56398. Needs Delve: go install github.com/go-delve/delve/cmd/dlv@latest
			// Delve has no password: anything on the network that reaches port 2345 can run code on this machine. On Windows,
			// allow only the Mac, in an administrator PowerShell:
			//   New-NetFirewallRule -DisplayName "Delve from Mac" -Direction Inbound -Protocol TCP -LocalPort 2345 -RemoteAddress 192.168.50.150 -Action Allow
			"label": "server: debug (Delve on 0.0.0.0:2345)",
			"type": "shell",
			"command": "dlv debug . --headless --listen=0.0.0.0:2345 --api-version=2 --accept-multiclient --continue",
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": {
				"owner": "go",
				"pattern": { "regexp": "^(.*\\.go):(\\d+):(\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "message": 4 },
				"background": { "beginsPattern": "^", "endsPattern": "API server listening at" }
			},
			"presentation": { "panel": "dedicated", "reveal": "always", "clear": true }
		},
		{
			// Codes live in the running server's memory, so start the server first ("server: run" or the debugger).
			// Uses go run so it works without the binary that "server: run" builds.
			"label": "server: enroll code",
			"type": "shell",
			"command": "go run . enroll-code ${input:enrollUser}",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": []
		},
		{
			// Reads every user's new files for the indexes once and exits, as the nightly run with "index": "daily" does.
			// Works beside a running server in "daily" mode (it then tells the server to read the results), but refuses
			// beside one in "server" mode, which reads files itself. Ctrl+C finishes the file in hand; the next run carries on.
			// Builds its own binary, journal-indexer, so the process has that name (go run would name it server-go, after
			// the module) and the build doesn't overwrite the journal-server binary a running "server: run" holds open.
			"label": "server: index now",
			"type": "shell",
			"command": "go build -o journal-indexer . && ./journal-indexer index",
			"windows": {
				"command": "go build -o journal-indexer.exe . ; if ($?) { .\\journal-indexer.exe index }"
			},
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "panel": "dedicated", "reveal": "always", "clear": true }
		},
		{
			// The same run with only the nudity scan and faces loaded and reading, to bring those up to date before the
			// slower indexes (OCR, search, similar, aesthetic); "server: index now" then catches up with the rest.
			"label": "server: index nudity and faces now",
			"type": "shell",
			"command": "go build -o journal-indexer . && ./journal-indexer index --only nudity,faces",
			"windows": {
				"command": "go build -o journal-indexer.exe . ; if ($?) { .\\journal-indexer.exe index --only nudity,faces }"
			},
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "panel": "dedicated", "reveal": "always", "clear": true }
		},
		{
			"label": "adb: devices",
			"type": "shell",
			"command": "adb devices -l",
			"osx": {
				"command": "${env:HOME}/Library/Android/sdk/platform-tools/adb devices -l"
			},
			"problemMatcher": []
		},
		{
			"label": "adb: enable TCP/IP on port 5555 (USB)",
			"type": "shell",
			"command": "adb -s YOUR_PHONE_SERIAL tcpip 5555",
			"osx": {
				"command": "${env:HOME}/Library/Android/sdk/platform-tools/adb -s YOUR_PHONE_SERIAL tcpip 5555"
			},
			"problemMatcher": []
		},
		{
			"label": "adb: hotspot IP (USB)",
			"type": "shell",
			"command": "adb -s YOUR_PHONE_SERIAL shell ip -4 addr show swlan0",
			"osx": {
				"command": "${env:HOME}/Library/Android/sdk/platform-tools/adb -s YOUR_PHONE_SERIAL shell ip -4 addr show swlan0"
			},
			"problemMatcher": []
		},
		{
			"label": "adb: connect over hotspot",
			"type": "shell",
			"command": "adb disconnect; adb connect ${input:phoneIp}:5555 && adb devices -l",
			"osx": {
				"command": "${env:HOME}/Library/Android/sdk/platform-tools/adb disconnect; ${env:HOME}/Library/Android/sdk/platform-tools/adb connect ${input:phoneIp}:5555 && ${env:HOME}/Library/Android/sdk/platform-tools/adb devices -l"
			},
			"problemMatcher": []
		},
		{
			"label": "adb: connect over hotspot (auto)",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/adb-hotspot.sh",
			"problemMatcher": []
		}
	]
}
